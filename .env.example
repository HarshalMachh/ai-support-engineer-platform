# Copy to .env and adjust. Never commit the real .env file.
# Values below work for local (non-Docker) development; docker-compose.yml overrides
# DATABASE_URL, REDIS_URL, OLLAMA_BASE_URL and KNOWLEDGE_DIR for container networking.

# --- Backend ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support_platform

# Generate your own, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra CORS origins
CORS_EXTRA_ORIGINS=

# --- Local AI (Ollama) -----------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

# "ollama" (nomic-embed-text, recommended) or "hash" (no model needed, keyword-level quality)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Must match the embedding model output size and the value used when migrations ran.
EMBEDDING_DIMENSION=768

AI_AUTO_ANALYZE=true
RAG_TOP_K=4
SIMILAR_TICKETS_TOP_K=3
RETRIEVAL_MIN_SIMILARITY=0.3
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MAX_UPLOAD_BYTES=1000000

RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- Docker Compose --------------------------------------------------------
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support_platform
# How the backend container reaches Ollama. Use http://ollama:11434 with `--profile ollama`.
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
# Host ports published by docker compose. Change them if something else already uses them
# (if you change POSTGRES_HOST_PORT, also update DATABASE_URL for non-Docker backend runs;
# if you change BACKEND_HOST_PORT, also update VITE_API_URL).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- Frontend --------------------------------------------------------------
VITE_API_URL=http://localhost:8000
